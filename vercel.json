{
  "framework": null,
  "buildCommand": "exit 0",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/((?!_next/|brand/|pairs/|coins/|icon.*|og.*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
